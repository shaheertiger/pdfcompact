# Canonical origin (apex host, no trailing slash). Used for canonicals, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://pdfcompact.com

# Ads are OFF at launch. Set these only after traffic justifies it (playbook: ~30K visits/month),
# and ads only ever render below the tool. Setting the client ID also opens the AdSense hosts in the CSP.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
