# The canonical URL of your deployed site (used for metadata, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://pdfcompact.com

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456).
# Leave unset until your AdSense account is approved — ads simply won't render.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: specific AdSense ad slot IDs for individual placements.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
