    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.29.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
